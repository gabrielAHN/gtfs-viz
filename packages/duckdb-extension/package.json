{
  "name": "@gtfs-viz/duckdb-extension",
  "version": "0.1.0",
  "description": "GTFS DuckDB extension — SQL macros, views, and TypeScript API for transit data",
  "license": "MIT",
  "author": "Gabriel AHN",
  "repository": {
    "type": "git",
    "url": "https://github.com/gabrielAHN/gtfs-viz.git",
    "directory": "packages/duckdb-extension"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./deckgl": {
      "import": "./dist/deckgl/index.js",
      "types": "./dist/deckgl/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node scripts/extract-sql-to-ts.mjs && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "~5.6.2"
  }
}
