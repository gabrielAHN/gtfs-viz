{
  "name": "@gabrielahn/gtfs-viz-cli",
  "version": "1.5.2",
  "description": "Lightweight GTFS data visualizer and editor — import, browse stations/stops/routes/pathways, edit connections, compare schedules, and export feeds from the terminal with DuckDB and a browser dashboard",
  "license": "MIT",
  "author": "Gabriel AHN",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabrielAHN/gtfs-viz.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/gabrielAHN/gtfs-viz/tree/main/packages/cli#readme",
  "keywords": [
    "gtfs",
    "transit",
    "duckdb",
    "cli",
    "visualization",
    "stations",
    "stops",
    "routes",
    "pathways",
    "accessibility",
    "schedules",
    "export"
  ],
  "bin": {
    "gtfs-viz": "dist/index.js"
  },
  "files": [
    "dist",
    "dashboard",
    "skills",
    "scripts",
    "README.md"
  ],
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/bundle.mjs && chmod +x dist/index.js && node scripts/copy-dashboard.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "postinstall": "node scripts/postinstall.mjs",
    "preuninstall": "node scripts/preuninstall.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@gtfs-viz/duckdb-extension": "*",
    "@types/node": "^22.10.5",
    "esbuild": "^0.28.0",
    "typescript": "~5.6.2"
  }
}
