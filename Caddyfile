{
	auto_https off
	admin off
}

:{$PORT:3000} {
	root * /app/dist
	encode gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
	}

	@assets {
		path /assets/*
	}
	header @assets Cache-Control "public, max-age=31536000, immutable"

	@fonts {
		path /font/*
	}
	header @fonts Cache-Control "public, max-age=31536000, immutable"

	@wasm {
		path *.wasm
	}
	header @wasm Content-Type "application/wasm"
	@bundledWasm {
		path *.wasm
		not path /extensions/*
	}
	header @bundledWasm Cache-Control "public, max-age=31536000, immutable"

	@extensions {
		path /extensions/*
	}
	header @extensions Cache-Control "no-cache"
	handle @extensions {
		file_server
	}

	@workers {
		path *.worker.js
	}
	header @workers {
		Content-Type "application/javascript"
		Cache-Control "public, max-age=31536000, immutable"
	}

	@html {
		path *.html
	}
	header @html Cache-Control "no-cache, no-store, must-revalidate"

	@docsText {
		path_regexp ^/docs/.*\.(md|txt)$
	}
	header @docsText Cache-Control "no-cache"
	@docsMarkdown {
		path_regexp ^/docs/.*\.md$
	}
	header @docsMarkdown Content-Type "text/markdown; charset=utf-8"

	@docs {
		path /docs /docs/*
	}
	handle @docs {
		redir /docs /docs/ 301
		@docsPage path_regexp ^/docs/(?:.*/)?[^/.]*$
		rewrite @docsPage /docs/index.html
		file_server
	}

	handle {
		try_files {path} /index.html
		file_server
	}
}
