{
  "name": "gtfs-viz",
  "version": "1.3.0",
  "private": true,
  "description": "Interactive GTFS visualization and editing tool running entirely in your browser",
  "keywords": [
    "deck.gl",
    "duckdb",
    "gtfs",
    "maps",
    "react",
    "transit",
    "visualization",
    "webassembly"
  ],
  "license": "MIT",
  "author": "Gabriel AHN",
  "repository": {
    "type": "git",
    "url": "https://github.com/gabrielAHN/gtfs-viz.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "yarn workspace @gtfs-viz/web run dev",
    "build": "yarn build:extension && yarn build:web && rm -rf dist && cp -r packages/web/dist dist && yarn build:cli",
    "build:extension": "yarn workspace @gtfs-viz/duckdb-extension run build",
    "build:web": "yarn workspace @gtfs-viz/web run build",
    "build:cli": "yarn workspace @gabrielahn/gtfs-viz-cli run build",
    "cli": "node packages/cli/dist/index.js",
    "cli:install-local": "yarn build && npm install -g ./packages/cli",
    "cli:install-skill": "gtfs-viz install-skill",
    "cli:link": "yarn build && yarn workspace @gabrielahn/gtfs-viz-cli link",
    "cli:pack": "yarn build && npm pack ./packages/cli",
    "cli:publish": "yarn build && npm publish ./packages/cli",
    "cli:publish-dry": "yarn build && npm publish ./packages/cli --dry-run",
    "check": "yarn workspace @gtfs-viz/duckdb-extension run check && yarn workspace @gtfs-viz/web run check && yarn workspace @gabrielahn/gtfs-viz-cli run check",
    "preview": "yarn workspace @gtfs-viz/web run preview",
    "postinstall": "node scripts/fix-duckdb-sourcemaps.mjs",
    "version": "echo v$(node -p \"require('./package.json').version\")",
    "release:patch": "npm version patch -m 'chore: release v%s'",
    "release:minor": "npm version minor -m 'chore: release v%s'",
    "release:major": "npm version major -m 'chore: release v%s'"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "typescript": "~5.6.2"
  },
  "resolutions": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.1.8",
    "vitest": "npm:@voidzero-dev/vite-plus-test@0.1.8"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
