{
  "name": "gtfs-viz",
  "private": true,
  "description": "Lightweight GTFS data visualizer and editor",
  "keywords": [
    "deck.gl",
    "duckdb",
    "gtfs",
    "maps",
    "react",
    "transit",
    "visualization",
    "webassembly"
  ],
  "license": "MIT",
  "author": "Gabriel AHN",
  "repository": {
    "type": "git",
    "url": "https://github.com/gabrielAHN/gtfs-viz.git"
  },
  "workspaces": [
    "packages/duckdb-client",
    "packages/lib"
  ],
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "yarn --cwd packages/web run dev",
    "build": "yarn build:duckdb-client && yarn build:lib && yarn build:web && yarn build:docs && rm -rf dist && cp -r packages/web/dist dist && cp -r packages/docs/dist dist/docs",
    "build:deploy": "vp run @gtfs-viz/duckdb-client#build && vp run @gtfs-viz/lib#build && VITE_GTFS_EXTENSION_REPOSITORY=/extensions VITE_GTFS_ALLOW_UNSIGNED_EXTENSIONS=true VITE_GTFS_DOCS_URL=${VITE_GTFS_DOCS_URL:-/docs/} yarn build:web && yarn build:docs && rm -rf dist && cp -r packages/web/dist dist && cp -r packages/docs/dist dist/docs && node scripts/extension-artifacts.mjs --out dist/extensions",
    "preview:deploy": "node scripts/preview-deploy.mjs",
    "build:duckdb-client": "yarn workspace @gtfs-viz/duckdb-client run build",
    "build:lib": "yarn workspace @gtfs-viz/lib run build",
    "test": "yarn build:duckdb-client && node --test tests/*.test.mjs packages/duckdb-client/tests/*.test.mjs packages/lib/tests/*.test.mjs packages/web/tests/*.test.mjs",
    "build:web": "yarn --cwd packages/web run build",
    "build:dashboard": "yarn build:duckdb-client && yarn build:lib && env -u VITE_GTFS_EXTENSION_REPOSITORY -u VITE_GTFS_ALLOW_UNSIGNED_EXTENSIONS -u VITE_GTFS_DOCS_URL yarn build:web && node scripts/dashboard-manifest.mjs --dist packages/web/dist",
    "build:docs": "yarn --cwd packages/docs run build",
    "dev:docs": "yarn --cwd packages/docs run dev",
    "start:docs": "yarn --cwd packages/docs run start",
    "check": "yarn workspace @gtfs-viz/lib run check && yarn workspace @gtfs-viz/duckdb-client run check && yarn --cwd packages/web run check && yarn --cwd packages/docs run check",
    "preview": "yarn --cwd packages/web run preview",
    "postinstall": "node scripts/fix-duckdb-sourcemaps.mjs"
  },
  "dependencies": {
    "@deck.gl/core": "^8.9.14",
    "@deck.gl/extensions": "^8.9.14",
    "@deck.gl/geo-layers": "^8.9.14",
    "@deck.gl/layers": "^8.9.14",
    "@deck.gl/mesh-layers": "^8.9.14",
    "@deck.gl/react": "^8.9.14",
    "@duckdb/duckdb-wasm": "^1.29.0",
    "@gtfs-viz/duckdb-client": "*",
    "@gtfs-viz/lib": "*",
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-collapsible": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-navigation-menu": "^1.2.3",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-scroll-area": "^1.2.2",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-toggle": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.62.16",
    "@tanstack/react-router": "^1.151.6",
    "@tanstack/react-table": "^8.20.6",
    "@xyflow/react": "^12.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.0.0",
    "date-fns": "^4.4.0",
    "deck.gl": "8.9.34",
    "elkjs": "^0.11.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.563.0",
    "maplibre-gl": "^4.7.1",
    "pako": "^1.0.11",
    "papaparse": "^5.4.1",
    "react": "^18.3.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-icons": "^5.5.0",
    "react-map-gl": "^7.1.7",
    "react-use-media-query-ts": "^1.0.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tanstack/router-plugin": "^1.151.6",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.0.0",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.28.0",
    "postcss": "^8.4.49",
    "rollup-plugin-visualizer": "^6.0.5",
    "tailwindcss": "^3.4.17",
    "terser": "^5.46.0",
    "typescript": "~5.6.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.1.8",
    "vite-bundle-visualizer": "^1.2.1",
    "vite-plus": "0.1.8"
  },
  "resolutions": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.1.8",
    "vitest": "npm:@voidzero-dev/vite-plus-test@0.1.8"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
