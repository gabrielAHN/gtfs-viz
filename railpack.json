{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "node": "22.12"
  },
  "steps": {
    "install": {
      "commands": [
        "yarn install --non-interactive --ignore-engines"
      ]
    },
    "build": {
      "inputs": [
        {
          "step": "install"
        }
      ],
      "commands": [
        "yarn build:deploy"
      ]
    }
  }
}
