{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "watchPatterns": [
      "packages/**",
      "scripts/**",
      "package.json",
      "yarn.lock",
      "railway.json",
      "railpack.json"
    ]
  },
  "deploy": {
    "startCommand": "caddy run --config /Caddyfile --adapter caddyfile 2>&1",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
